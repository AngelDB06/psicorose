{
    "plugins": ["plugins/markdown", "jsdoc-babel"],
    "source": {
        "include": ["frontend/src"],
        "includePattern": ".+\\.jsx?$",
        "excludePattern": "(^|\\/|\\\\)_"
    },
    "opts": {
        "destination": "docs/frontend",
        "recurse": true,
        "readme": "frontend/README.md"
    },
    "templates": {
        "cleverLinks": true,
        "monospaceLinks": true
    },
    "babel": {
        "presets": ["@babel/preset-react"]
    }
}
